                                                                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                                                                Width="16" Height="16" Padding="0"
                                                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                Tag="FilterSource" Click="ClearSingleFilter_Click"
