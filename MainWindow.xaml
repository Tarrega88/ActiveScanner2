                                                                        Command="{Binding Data.SortByColumnCommand, Source={StaticResource TabProxy}}"
                                                                        CommandParameter="DriverName">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Driver/Model" VerticalAlignment="Center"/>
                                                                        <materialDesign:PackIcon Kind="{Binding Data.SortDirection, Source={StaticResource TabProxy}, Converter={StaticResource SortDirectionToIconConverter}}"
                                                                                                 Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon.Visibility>
                                                                                <MultiBinding Converter="{StaticResource SortColumnVisibilityConverter}" ConverterParameter="DriverName">
                                                                                    <Binding Path="Data.SortColumn" Source="{StaticResource TabProxy}"/>
                                                                                    <Binding Path="Data.SortDirection" Source="{StaticResource TabProxy}"/>
                                                                                </MultiBinding>
                                                                            </materialDesign:PackIcon.Visibility>
                                                                        </materialDesign:PackIcon>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox Grid.Column="0" Style="{StaticResource FilterModeComboBox}"
                                                                              ItemsSource="{Binding Source={StaticResource FilterModeValues}}"
                                                                              SelectedItem="{Binding Data.FilterDriverNameMode, Source={StaticResource TabProxy}}"/>
                                                                    <Grid Grid.Column="1" Margin="4,0,0,0">
                                                                        <TextBox Text="{Binding Data.FilterDriverName, Source={StaticResource TabProxy}, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                                 materialDesign:HintAssist.Hint="Filter..."
                                                                                 KeyDown="FilterTextBox_KeyDown" TextChanged="FilterTextBox_TextChanged"
                                                                                 Padding="4,4,20,4" Height="26" FontSize="11"/>
                                                                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                                                                Width="16" Height="16" Padding="0"
                                                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                Tag="FilterDriverName" Click="ClearSingleFilter_Click"
                                                                                Visibility="{Binding Data.FilterDriverName, Source={StaticResource TabProxy}, Converter={StaticResource StringToVisibilityConverter}}"
                                                                                ToolTip="Clear filter">
                                                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding DriverName}" VerticalAlignment="Center" Margin="4,0"/>
                                                                    <Button Grid.Column="1" Style="{StaticResource CellCopyButton}" 
                                                                            Tag="{Binding DriverName}" Click="CopyCellText_Click"
                                                                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridCell}, Converter={StaticResource BoolToHiddenVisibilityConverter}}">
                                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- UNC Path Column - Printers only -->
                                                    <DataGridTemplateColumn Width="200" MinWidth="120" SortMemberPath="UNCName"
                                                                            Visibility="{Binding Data.ShowsPrinters, Source={StaticResource TabProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <DataGridTemplateColumn.Header>
                                                            <StackPanel Margin="0,2,0,4">
                                                                <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0" MinWidth="0" HorizontalAlignment="Left"
                                                                        Command="{Binding Data.SortByColumnCommand, Source={StaticResource TabProxy}}"
                                                                        CommandParameter="UNCName">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="UNC Path" VerticalAlignment="Center"/>
                                                                        <materialDesign:PackIcon Kind="{Binding Data.SortDirection, Source={StaticResource TabProxy}, Converter={StaticResource SortDirectionToIconConverter}}"
                                                                                                 Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon.Visibility>
                                                                                <MultiBinding Converter="{StaticResource SortColumnVisibilityConverter}" ConverterParameter="UNCName">
                                                                                    <Binding Path="Data.SortColumn" Source="{StaticResource TabProxy}"/>
                                                                                    <Binding Path="Data.SortDirection" Source="{StaticResource TabProxy}"/>
                                                                                </MultiBinding>
                                                                            </materialDesign:PackIcon.Visibility>
                                                                        </materialDesign:PackIcon>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox Grid.Column="0" Style="{StaticResource FilterModeComboBox}"
                                                                              ItemsSource="{Binding Source={StaticResource FilterModeValues}}"
                                                                              SelectedItem="{Binding Data.FilterUncNameMode, Source={StaticResource TabProxy}}"/>
                                                                    <Grid Grid.Column="1" Margin="4,0,0,0">
                                                                        <TextBox Text="{Binding Data.FilterUncName, Source={StaticResource TabProxy}, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                                 materialDesign:HintAssist.Hint="Filter..."
                                                                                 KeyDown="FilterTextBox_KeyDown" TextChanged="FilterTextBox_TextChanged"
                                                                                 Padding="4,4,20,4" Height="26" FontSize="11"/>
                                                                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                                                                Width="16" Height="16" Padding="0"
                                                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                Tag="FilterUncName" Click="ClearSingleFilter_Click"
                                                                                Visibility="{Binding Data.FilterUncName, Source={StaticResource TabProxy}, Converter={StaticResource StringToVisibilityConverter}}"
                                                                                ToolTip="Clear filter">
                                                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding UNCName}" VerticalAlignment="Center" Margin="4,0"/>
                                                                    <Button Grid.Column="1" Style="{StaticResource CellCopyButton}" 
                                                                            Tag="{Binding UNCName}" Click="CopyCellText_Click"
                                                                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridCell}, Converter={StaticResource BoolToHiddenVisibilityConverter}}">
                                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Location Column - Printers only -->
                                                    <DataGridTemplateColumn Width="250" MinWidth="85" SortMemberPath="Location"
                                                                            Visibility="{Binding Data.ShowsPrinters, Source={StaticResource TabProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <DataGridTemplateColumn.Header>
                                                            <StackPanel Margin="0,2,0,4">
                                                                <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0" MinWidth="0" HorizontalAlignment="Left"
                                                                        Command="{Binding Data.SortByColumnCommand, Source={StaticResource TabProxy}}"
                                                                        CommandParameter="Location">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="Location" VerticalAlignment="Center"/>
                                                                        <materialDesign:PackIcon Kind="{Binding Data.SortDirection, Source={StaticResource TabProxy}, Converter={StaticResource SortDirectionToIconConverter}}"
                                                                                                 Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon.Visibility>
                                                                                <MultiBinding Converter="{StaticResource SortColumnVisibilityConverter}" ConverterParameter="Location">
                                                                                    <Binding Path="Data.SortColumn" Source="{StaticResource TabProxy}"/>
                                                                                    <Binding Path="Data.SortDirection" Source="{StaticResource TabProxy}"/>
                                                                                </MultiBinding>
                                                                            </materialDesign:PackIcon.Visibility>
                                                                        </materialDesign:PackIcon>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox Grid.Column="0" Style="{StaticResource FilterModeComboBox}"
                                                                              ItemsSource="{Binding Source={StaticResource FilterModeValues}}"
                                                                              SelectedItem="{Binding Data.FilterLocationMode, Source={StaticResource TabProxy}}"/>
                                                                    <Grid Grid.Column="1" Margin="4,0,0,0">
                                                                        <TextBox Text="{Binding Data.FilterLocation, Source={StaticResource TabProxy}, UpdateSourceTrigger=PropertyChanged}"
                                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                                 materialDesign:HintAssist.Hint="Filter..."
                                                                                 KeyDown="FilterTextBox_KeyDown" TextChanged="FilterTextBox_TextChanged"
                                                                                 Padding="4,4,20,4" Height="26" FontSize="11"/>
                                                                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                                                                Width="16" Height="16" Padding="0"
                                                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                Tag="FilterLocation" Click="ClearSingleFilter_Click"
                                                                                Visibility="{Binding Data.FilterLocation, Source={StaticResource TabProxy}, Converter={StaticResource StringToVisibilityConverter}}"
                                                                                ToolTip="Clear filter">
                                                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Location}" VerticalAlignment="Center" Margin="4,0"/>
                                                                    <Button Grid.Column="1" Style="{StaticResource CellCopyButton}" 
                                                                            Tag="{Binding Location}" Click="CopyCellText_Click"
                                                                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridCell}, Converter={StaticResource BoolToHiddenVisibilityConverter}}">
                                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- ========== SHARED COLUMNS ========== -->
                                                    
                                                    <!-- AD Logon Column - Users only (Computers has its own in the Computer columns section) -->
                                                    <DataGridTemplateColumn Width="200" MinWidth="95" SortMemberPath="LastLogon"
                                                                            Visibility="{Binding Data.ShowsUsers, Source={StaticResource TabProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <DataGridTemplateColumn.Header>
                                                            <StackPanel Margin="0,2,0,4">
                                                                <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Margin="0" MinWidth="0" HorizontalAlignment="Left"
                                                                        Command="{Binding Data.SortByColumnCommand, Source={StaticResource TabProxy}}"
                                                                        CommandParameter="LastLogon">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="AD Logon" VerticalAlignment="Center"/>
                                                                        <materialDesign:PackIcon Kind="{Binding Data.SortDirection, Source={StaticResource TabProxy}, Converter={StaticResource SortDirectionToIconConverter}}"
                                                                                                 Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon.Visibility>
                                                                                <MultiBinding Converter="{StaticResource SortColumnVisibilityConverter}" ConverterParameter="LastLogon">
                                                                                    <Binding Path="Data.SortColumn" Source="{StaticResource TabProxy}"/>
                                                                                    <Binding Path="Data.SortDirection" Source="{StaticResource TabProxy}"/>
                                                                                </MultiBinding>
                                                                            </materialDesign:PackIcon.Visibility>
                                                                        </materialDesign:PackIcon>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0" Content="{Binding Data.FilterLastLogonDirectionText, Source={StaticResource TabProxy}}" 
                                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                                            Padding="4,0" MinWidth="24" Height="26"
                                                                            Command="{Binding Data.ToggleLastLogonDirectionCommand, Source={StaticResource TabProxy}}"
                                                                            ToolTip="Toggle: > (older than) or &lt; (within)"/>
                                                                    <TextBox Grid.Column="1" Text="{Binding Data.FilterLastLogonDays, Source={StaticResource TabProxy}, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                             materialDesign:HintAssist.Hint="days"
                                                                             KeyDown="FilterTextBox_KeyDown" TextChanged="FilterTextBox_TextChanged"
                                                                             Padding="4" Height="26" FontSize="11" Margin="4,0,0,0"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding LastLogon, Converter={StaticResource UtcToLocalDateTimeConverter}}" VerticalAlignment="Center" Margin="4,0"/>
                                                                    <Button Grid.Column="1" Style="{StaticResource CellCopyButton}" 
                                                                            Tag="{Binding LastLogon, Converter={StaticResource UtcToLocalDateTimeConverter}}" Click="CopyCellText_Click"
                                                                            Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridCell}, Converter={StaticResource BoolToHiddenVisibilityConverter}}">
                                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>

                                        <!-- Running indicator -->
                                        <ProgressBar IsIndeterminate="True" 
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     VerticalAlignment="Top"/>

                                        <!-- ============ Vulnerabilities tab ============ -->
                                        <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Vulnerabilities}">
                                            <Grid.Resources>
                                                <converters:BindingProxy x:Key="VulnScanProxy" Data="{Binding VulnerabilityScan}"/>
                                            </Grid.Resources>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Toolbar -->
                                            <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="0,0,0,1" Padding="8,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="ShieldBug" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding VulnerabilityScan.TotalCount, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Medium"/>
                                                        <TextBlock Text=" total  •  " VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding VulnerabilityScan.WindowsCount, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Medium" Foreground="#4CAF50"/>
                                                        <TextBlock Text=" Windows  •  " VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding VulnerabilityScan.NonWindowsCount, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Medium"/>
                                                        <TextBlock Text=" non-Windows  •  " VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding VulnerabilityScan.FixCount, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <TextBlock Text=" fixes" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding VulnerabilityScan.ScanStatus, Mode=OneWay}"
                                                               VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Command="{Binding VulnerabilityScan.ToggleSettingsCommand}"
                                                                ToolTip="Scan settings (assignment group, endpoints)"
                                                                Width="30" Height="30" Padding="0" Margin="0,0,8,0">
                                                            <materialDesign:PackIcon Kind="Cog" Width="18" Height="18"/>
                                                        </Button>
                                                        <Button Content="Check versions"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding VulnerabilityScan.VerifyVersionsCommand}"
                                                                ToolTip="Read-only: query the actual installed version on each device over WinRM"
                                                                Padding="8,2" Margin="0,0,8,0"/>
                                                        <Button Content="Check egress"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding VulnerabilityScan.CheckEgressCommand}"
                                                                ToolTip="Read-only: test whether each device can reach the winget/GitHub/.NET download sources before any remediation"
                                                                Padding="8,2" Margin="0,0,8,0"/>
                                                        <Button Content="Remediate"
                                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                                Command="{Binding VulnerabilityScan.RemediateCommand}"
                                                                ToolTip="Push the approved fix (pinned to each finding's Fixed version) to every device where the finding is Fixable — installs software over WinRM after a confirmation"
                                                                Padding="8,2" Margin="0,0,8,0"/>
                                                        <Button Content="Reload"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding VulnerabilityScan.RescanAllCommand}"
                                                                ToolTip="Reload ServiceNow data for all devices in this tab"
                                                                Padding="8,2" Margin="0,0,8,0"/>
                                                        <Button Content="Cancel"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding VulnerabilityScan.CancelScanCommand}"
                                                                Visibility="{Binding VulnerabilityScan.IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Foreground="#E53935" Padding="8,2"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Editable scan settings (collapsible) -->
                                            <Border Grid.Row="1" Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="0,0,0,1" Padding="12,8"
                                                    Visibility="{Binding VulnerabilityScan.IsSettingsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBox materialDesign:HintAssist.Hint="Assignment group (blank = all)"
                                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                             Text="{Binding VulnerabilityScan.AssignmentGroup, UpdateSourceTrigger=LostFocus}"
                                                             Margin="0,0,0,8"/>
                                                    <TextBox materialDesign:HintAssist.Hint="Vulnerable item list URL"
                                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                             Text="{Binding VulnerabilityScan.VulnerableItemListUrl, UpdateSourceTrigger=LostFocus}"
                                                             FontSize="11" Margin="0,0,0,8"/>
                                                    <TextBox materialDesign:HintAssist.Hint="Third-party entry URL"
                                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                             Text="{Binding VulnerabilityScan.ThirdPartyEntryUrl, UpdateSourceTrigger=LostFocus}"
                                                             FontSize="11" Margin="0,0,0,8"/>
                                                    <TextBox materialDesign:HintAssist.Hint="Computer CMDB URL"
                                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                             Text="{Binding VulnerabilityScan.ComputerCmdbUrl, UpdateSourceTrigger=LostFocus}"
                                                             FontSize="11" Margin="0,0,0,8"/>
                                                    <TextBox materialDesign:HintAssist.Hint="Excluded state codes (comma-separated; 3=Closed)"
                                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                             Text="{Binding VulnerabilityScan.ExcludedStates, UpdateSourceTrigger=LostFocus}"
                                                             FontSize="11"/>
                                                    <TextBox materialDesign:HintAssist.Hint="Egress test endpoints (comma-separated HTTPS URLs)"
                                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                             Text="{Binding VulnerabilityScan.EgressEndpoints, UpdateSourceTrigger=LostFocus}"
                                                             FontSize="11" Margin="0,8,0,0"/>
                                                    <TextBox materialDesign:HintAssist.Hint="Max devices to remediate in parallel"
                                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                             Text="{Binding VulnerabilityScan.MaxRemediationConcurrency, UpdateSourceTrigger=LostFocus}"
                                                             FontSize="11" Margin="0,8,0,0"/>
                                                    <TextBlock Text="Changes are saved automatically and apply on the next scan."
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}" FontStyle="Italic"
                                                               FontSize="11" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Egress preflight results (collapsible) -->
                                            <Border Grid.Row="2" Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="0,0,0,1" Padding="12,8"
                                                    Visibility="{Binding VulnerabilityScan.IsEgressExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="Lan" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                            <TextBlock Text="Egress preflight" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding VulnerabilityScan.EgressProgress}" Margin="8,0,0,0"
                                                                       VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        </StackPanel>
                                                        <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}"
                                                                Command="{Binding VulnerabilityScan.ToggleEgressCommand}"
                                                                ToolTip="Hide egress results" Width="26" Height="26" Padding="0">
                                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                        </Button>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding VulnerabilityScan.EgressResults}"
                                                                  MaxHeight="150">
                                                        <ItemsControl.Template>
                                                            <ControlTemplate TargetType="ItemsControl">
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                    <ItemsPresenter/>
                                                                </ScrollViewer>
                                                            </ControlTemplate>
                                                        </ItemsControl.Template>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ToolTip>
                                                                        <ToolTip MaxWidth="520">
                                                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
                                                                        </ToolTip>
                                                                    </Grid.ToolTip>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="20"/>
                                                                        <ColumnDefinition Width="160"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <materialDesign:PackIcon Grid.Column="0" VerticalAlignment="Center" Width="16" Height="16">
                                                                        <materialDesign:PackIcon.Style>
                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                <Setter Property="Kind" Value="HelpCircleOutline"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding State}" Value="Reachable">
                                                                                        <Setter Property="Kind" Value="CheckCircle"/>
                                                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding State}" Value="Partial">
                                                                                        <Setter Property="Kind" Value="AlertCircle"/>
                                                                                        <Setter Property="Foreground" Value="#FB8C00"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding State}" Value="Blocked">
                                                                                        <Setter Property="Kind" Value="CloseCircle"/>
                                                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding State}" Value="Offline">
                                                                                        <Setter Property="Kind" Value="LanDisconnect"/>
                                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding State}" Value="DnsMismatch">
                                                                                        <Setter Property="Kind" Value="AlertRhombus"/>
                                                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                                                                        <Setter Property="Kind" Value="AlertOctagon"/>
                                                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding State}" Value="Checking">
                                                                                        <Setter Property="Kind" Value="DotsHorizontal"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </materialDesign:PackIcon.Style>
                                                                    </materialDesign:PackIcon>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DeviceName}" VerticalAlignment="Center"
                                                                               FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource MaterialDesignBodyLight}" TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="Read-only reachability test to the winget/GitHub/.NET download sources. Hover a row for per-endpoint detail."
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}" FontStyle="Italic"
                                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Scan progress bar -->
                                            <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="3"
                                                         Visibility="{Binding VulnerabilityScan.IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <!-- Findings grid -->
                                            <DataGrid Grid.Row="4"
                                                      ItemsSource="{Binding VulnerabilityScan.ItemsView}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="False"
                                                      SelectionMode="Extended"
                                                      GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column"
                                                      IsVisibleChanged="VulnFindingsGrid_IsVisibleChanged"
                                                      Loaded="VulnFindingsGrid_Loaded"
                                                      materialDesign:DataGridAssist.CellPadding="8,4"
                                                      materialDesign:DataGridAssist.ColumnHeaderPadding="8,6">
                                                <DataGrid.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.ContainerStyle>
                                                            <Style TargetType="{x:Type GroupItem}">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                            <Expander IsExpanded="True" Margin="0,2,0,0"
                                                                                      Background="{DynamicResource MaterialDesignToolBarBackground}">
                                                                                <Expander.Header>
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <materialDesign:PackIcon Kind="PackageVariantClosed" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="  (" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                                                        <TextBlock Text="{Binding ItemCount}" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                                                        <TextBlock Text=" item(s))" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                                                    </StackPanel>
                                                                                </Expander.Header>
                                                                                <ItemsPresenter/>
                                                                            </Expander>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </GroupStyle.ContainerStyle>
                                                    </GroupStyle>
                                                </DataGrid.GroupStyle>
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                        <Setter Property="ContextMenu">
                                                            <Setter.Value>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Remediate this finding"
                                                                              Command="{Binding Data.RemediateItemCommand, Source={StaticResource VulnScanProxy}}"
                                                                              CommandParameter="{Binding}">
                                                                        <MenuItem.Icon>
                                                                            <materialDesign:PackIcon Kind="WrenchOutline"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <MenuItem Header="Reload this device"
                                                                              Command="{Binding Data.RescanDeviceCommand, Source={StaticResource VulnScanProxy}}"
                                                                              CommandParameter="{Binding DeviceName}">
                                                                        <MenuItem.Icon>
                                                                            <materialDesign:PackIcon Kind="Refresh"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </ContextMenu>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWindows}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                                                <Setter Property="Opacity" Value="0.55"/>
                                                                <Setter Property="ToolTip" Value="Non-Windows finding — not remediable from ActiveScanner."/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" IsReadOnly="True" Width="110"/>
                                                    <DataGridTextColumn Header="VIT" Binding="{Binding Number}" IsReadOnly="True" Width="110"/>
                                                    <DataGridTextColumn Header="TEN id" Binding="{Binding TenId}" IsReadOnly="True" Width="100"/>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="200"/>
                                                    <DataGridTextColumn Binding="{Binding InstalledVersion}" IsReadOnly="True" Width="110">
                                                        <DataGridTextColumn.Header>
                                                            <TextBlock Text="Reported (SNOW)"
                                                                       ToolTip="Version ServiceNow/Tenable reported as installed. May be stale — use Check versions for the actual on-device version."/>
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Binding="{Binding FixedVersion}" IsReadOnly="True" Width="95">
                                                        <DataGridTextColumn.Header>
                                                            <TextBlock Text="Target"
                                                                       ToolTip="Target version from the vulnerability proof (the version this finding expects)."/>
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Binding="{Binding VerifiedVersion}" IsReadOnly="True" Width="100">
                                                        <DataGridTextColumn.Header>
                                                            <TextBlock Text="On Device"
                                                                       ToolTip="Version read directly from the device during Check versions or post-remediation verify. Blank until a local verify is run."/>
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Type" Binding="{Binding InstallTypeLabel}" IsReadOnly="True" Width="150"/>
                                                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" IsReadOnly="True" Width="110"/>
                                                    <DataGridTextColumn Header="Package / Fix" Binding="{Binding FixLabel}" IsReadOnly="True" Width="170"/>
                                                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskRating}" IsReadOnly="True" Width="90"/>
                                                    <DataGridTemplateColumn Header="Status" Width="140" SortMemberPath="Eligibility">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                            ToolTip="{Binding StatusText}">
                                                                    <materialDesign:PackIcon VerticalAlignment="Center" Width="16" Height="16" Margin="0,0,4,0">
                                                                        <materialDesign:PackIcon.Style>
                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                <Setter Property="Kind" Value="HelpCircleOutline"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Eligibility}" Value="Fixable">
                                                                                        <Setter Property="Kind" Value="WrenchOutline"/>
                                                                                        <Setter Property="Foreground" Value="#1E88E5"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Eligibility}" Value="Fixed">
                                                                                        <Setter Property="Kind" Value="CheckCircle"/>
                                                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Eligibility}" Value="Unreachable">
                                                                                        <Setter Property="Kind" Value="LanDisconnect"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Eligibility}" Value="DnsMismatch">
                                                                                        <Setter Property="Kind" Value="AlertRhombus"/>
                                                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Eligibility}" Value="NotApplicable">
                                                                                        <Setter Property="Kind" Value="MinusCircleOutline"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </materialDesign:PackIcon.Style>
                                                                    </materialDesign:PackIcon>
                                                                    <TextBlock Text="{Binding EligibilityLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridCheckBoxColumn Header="Reboot" Binding="{Binding RebootAfter, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                                    <DataGridTemplateColumn Header="" Width="Auto">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                                        Padding="4,0" MinWidth="24" Height="26"
                                                                        ToolTip="Re-scan this device"
                                                                        Command="{Binding Data.RescanDeviceCommand, Source={StaticResource VulnScanProxy}}"
                                                                        CommandParameter="{Binding DeviceName}">
                                                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </DockPanel>

                        <!-- Loading Spinner Overlay (only for non-network operations) -->
                        <Border Background="#80000000">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource BusyAndNotNetworkConverter}">
                                    <Binding Path="IsBusy"/>
                                    <Binding Path="IsNetworkOperationRunning"/>
                                </MultiBinding>
                            </Border.Visibility>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                             IsIndeterminate="True"
                                             Width="48" Height="48"
                                             Value="0"/>
                                <TextBlock Text="{Binding BusyMessage}" 
                                           Foreground="White"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Network History Panel -->
            <Grid Grid.Row="2" x:Name="NetworkPanel">
                <!-- Grip Bar -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}"
                        Cursor="SizeNS" x:Name="NetworkPanelGrip"
                        MouseLeftButtonDown="NetworkPanelGrip_MouseLeftButtonDown"
                        MouseLeftButtonUp="NetworkPanelGrip_MouseLeftButtonUp"
                        MouseMove="NetworkPanelGrip_MouseMove"
                        Padding="0,2">
                    <Grid>
                        <Rectangle Width="40" Height="2" Fill="{DynamicResource MaterialDesignBodyLight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" RadiusX="1" RadiusY="1" Margin="0,1,0,0"/>
                        <TextBlock Text="Network Output" FontSize="10" Opacity="0.6"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,4,0,0"/>
                        <Button Style="{StaticResource MaterialDesignToolForegroundButton}"
                                Command="{Binding ClearNetworkHistoryCommand}"
                                ToolTip="Clear output"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="0" Margin="0,0,8,0" Width="20" Height="20"
                                Cursor="Arrow">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- History Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="NetworkHistoryScrollViewer"
                              Height="{Binding NetworkPanelHeight}"
                              Background="{DynamicResource MaterialDesignPaper}">
                    <ItemsControl ItemsSource="{Binding NetworkHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="12,4,12,4">
                                    <!-- Header: [HH:mm:ss] Action → targets -->
                                    <TextBlock Text="{Binding HeaderText}" 
                                               FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding StatusColor, Converter={StaticResource StringToColorBrushConverter}}"/>
                                    <!-- Result text (indented, monospaced) -->
                                    <TextBlock Text="{Binding ResultText}" 
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource MaterialDesignBody}"
                                               Opacity="0.85"
                                               Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <!-- Running indicator for in-progress entries -->
                                    <StackPanel Orientation="Horizontal" Margin="12,2,0,0"
                                                Visibility="{Binding IsComplete, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                                     Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                                        <TextBlock Text="  running..." FontFamily="Consolas" FontSize="11" Opacity="0.5"
                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Status Bar -->
            <materialDesign:ColorZone Grid.Row="3" Mode="PrimaryDark" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Message -->
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"/>

                    <!-- Object Count (hidden when 0/0) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center"
                                Visibility="{Binding SelectedOutputTab.FilteredCount, FallbackValue=0, Converter={StaticResource CountToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedCount}" VerticalAlignment="Center"/>
                        <TextBlock Text=" / " VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedOutputTab.FilteredCount, FallbackValue=0}" VerticalAlignment="Center"/>
                        <TextBlock Text=" objects" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Fixed-Width Operation Name / Query Time -->
                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Width="80" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNetworkOperationRunning}" Value="True">
                                        <Setter Property="Text" Value="{Binding NetworkOperationName}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDnsResolving}" Value="True">
                                        <Setter Property="Text" Value="DNS"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Text" Value="LDAP"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding LastQueryTime}"/>
                    </TextBlock>

                    <!-- Activity Indicator -->
                    <Grid Grid.Column="3" VerticalAlignment="Center" Width="120" Height="18"
                          x:Name="ActivityIndicator">
                        <ProgressBar Height="18" Background="Transparent"
                                     Foreground="{DynamicResource SecondaryHueMidBrush}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignLinearProgressBar}">
                                    <Setter Property="IsIndeterminate" Value="False"/>
                                    <Setter Property="Value" Value="100"/>
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsIndeterminate" Value="True"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDnsResolving}" Value="True">
                                            <Setter Property="IsIndeterminate" Value="True"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNetworkOperationRunning}" Value="True">
                                            <Setter Property="IsIndeterminate" Value="True"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <!-- Progress text inside bar (hidden on hover when cancellable) -->
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Ready"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNetworkOperationRunning}" Value="True">
                                            <Setter Property="Text" Value="{Binding NetworkOperationProgress}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDnsResolving}" Value="True">
                                            <Setter Property="Text" Value="{Binding NetworkOperationProgress}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Text" Value="Loading"/>
                                        </DataTrigger>
                                        <!-- Hide text on hover when network op or DNS is running -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsNetworkOperationRunning}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=ActivityIndicator}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDnsResolving}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=ActivityIndicator}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Cancel overlay (shown on hover when network op or DNS is running) -->
                        <Button Command="{Binding CancelActivityCommand}"
                                Cursor="Hand" Background="Transparent" BorderBrush="Transparent"
                                Padding="0" Height="18" HorizontalContentAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsNetworkOperationRunning}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=ActivityIndicator}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDnsResolving}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=ActivityIndicator}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="OrangeRed"/>
                                <TextBlock Text="Cancel" FontSize="11" VerticalAlignment="Center" Foreground="OrangeRed"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Cell Peek Popup - shown on long-press to display full cell text -->
            <Popup x:Name="CellPeekPopup" AllowsTransparency="True" 
                   Placement="Absolute" StaysOpen="False" IsHitTestVisible="False">
                <Border Background="{DynamicResource MaterialDesignPaper}" 
                        BorderBrush="{DynamicResource PrimaryHueMidBrush}" 
                        BorderThickness="1" CornerRadius="4" 
                        Padding="10,6" MaxWidth="600">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                    </Border.Effect>
                    <TextBlock x:Name="CellPeekText" 
                               TextWrapping="Wrap" 
                               FontSize="13"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                </Border>
            </Popup>

            <!-- Error Banner -->
            <materialDesign:Snackbar Grid.Row="1" 
                                     MessageQueue="{materialDesign:MessageQueue}"
                                     x:Name="ErrorSnackbar"/>
        </Grid>
    </materialDesign:DialogHost>
</Window>
