<Window x:Class="ActiveScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ActiveScanner.ViewModels"
        xmlns:models="clr-namespace:ActiveScanner.Models"
        xmlns:converters="clr-namespace:ActiveScanner.Converters"
        mc:Ignorable="d"
        Title="Active Scanner" 
        Height="900" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- BindingProxy for MainViewModel - allows context menus to access window DataContext -->
        <converters:BindingProxy x:Key="MainViewModelProxy" Data="{Binding}"/>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <materialDesign:ColorZone Mode="PrimaryMid" Padding="12" Grid.Row="0" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <materialDesign:PackIcon Kind="FolderNetwork" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Active Scanner" Style="{StaticResource MaterialDesignHeadline6TextBlock}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="2">
                        <!-- Export Button with Popup -->
                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges" StaysOpen="True"
                                                 ToolTip="Export" Margin="0,0,8,0">
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:PackIcon Kind="Export" Foreground="White" Width="24" Height="24"/>
                            </materialDesign:PopupBox.ToggleContent>
                            <Border Padding="16" MinWidth="280">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Text="Export Results" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                    
                                    <!-- Source selection -->
                                    <ComboBox Grid.Row="1" materialDesign:HintAssist.Hint="Source"
                                              SelectedValue="{Binding SelectedExportSource}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Margin="0,0,0,8">
                                        <ComboBoxItem Content="Current Tab" Tag="{x:Static models:ExportSource.CurrentTab}"/>
                                        <ComboBoxItem Content="Last User Database" Tag="{x:Static models:ExportSource.LastUserDatabase}"/>
                                    </ComboBox>
                                    
                                    <!-- Format selection -->
                                    <ComboBox Grid.Row="2" materialDesign:HintAssist.Hint="Format"
                                              SelectedValue="{Binding SelectedExportFormat}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Margin="0,0,0,8">
                                        <ComboBoxItem Content="Excel (.xlsx)" Tag="{x:Static models:ExportFormat.Excel}"/>
                                        <ComboBoxItem Content="CSV (.csv)" Tag="{x:Static models:ExportFormat.Csv}"/>
                                        <ComboBoxItem Content="JSON (.json)" Tag="{x:Static models:ExportFormat.Json}"/>
                                        <ComboBoxItem Content="Text (.txt)" Tag="{x:Static models:ExportFormat.Text}"/>
                                        <ComboBoxItem Content="HTML (.html)" Tag="{x:Static models:ExportFormat.Html}"/>
                                        <ComboBoxItem Content="Clipboard" Tag="{x:Static models:ExportFormat.Clipboard}"/>
                                    </ComboBox>
                                    
                                    <!-- Folder selection -->
                                    <Grid Grid.Row="3" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ExportFolder}"
                                                 materialDesign:HintAssist.Hint="Base Folder"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding BrowseExportFolderCommand}" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="FolderOpen"/>
                                        </Button>
                                    </Grid>

                                    <!-- Full export path display -->
                                    <TextBlock Grid.Row="4" 
                                               Text="{Binding FullExportPath}" 
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxWidth="250"
                                               ToolTip="{Binding FullExportPath}"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               FontSize="11"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding UseOrganizedExports, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    
                                    <!-- Export button and organize option -->
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <CheckBox Content="Organize" 
                                                  IsChecked="{Binding UseOrganizedExports}"
                                                  ToolTip="Exports to: [Base Folder]/Active Scanner Exports/[Format]/"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="Export" 
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Command="{Binding ExportCommand}"
                                                Padding="16,4"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </materialDesign:PopupBox>
                        <!-- ServiceNow Connection Button -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding SnowLoginCommand}"
                                Foreground="White"
                                ToolTip="Connect to ServiceNow for SNOW ID lookups">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Snowflake" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Check" Width="10" Height="10" Margin="-6,8,0,0"
                                                         Foreground="#4CAF50"
                                                         Visibility="{Binding IsSnowAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <!-- Admin Login/Logout Button -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Command="{Binding AdminLoginCommand}"
                                Foreground="White"
                                ToolTip="{Binding IsAdminLoggedIn, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Logout Admin ({0})|Login as Admin'}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding IsAdminLoggedIn, Converter={StaticResource BoolToIconConverter}, ConverterParameter='ShieldAccount|AccountCircleOutline'}" 
                                                         VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Check" Width="10" Height="10" Margin="-6,8,0,0"
                                                         Foreground="#4CAF50"
                                                         Visibility="{Binding IsAdminLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Command="{Binding ToggleDarkModeCommand}"
                                ToolTip="Toggle Dark Mode"
                                Foreground="White">
                            <materialDesign:PackIcon Kind="{Binding IsDarkMode, Converter={StaticResource BoolToIconConverter}, ConverterParameter='WeatherNight|WeatherSunny'}"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                ToolTip="Settings"
                                Click="OpenSettings_Click"
                                Foreground="White">
                            <materialDesign:PackIcon Kind="Cog"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                ToolTip="Help"
                                Click="OpenHelp_Click"
                                Foreground="White">
                            <materialDesign:PackIcon Kind="HelpCircle"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Navigation -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,12">
                        
                        <!-- Create Domain Group Button -->
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Command="{Binding CreateGroupCommand}" 
                                Padding="12,6" Margin="0,0,0,16" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Create Domain Group" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Collapsible Domain Groups List -->
                        <Expander x:Name="DomainGroupsExpander" IsExpanded="True" Margin="0,0,0,8" 
                                  materialDesign:ExpanderAssist.HorizontalHeaderPadding="0"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="FolderMultiple" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Domain Groups" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding SavedTargetGroups.Count, StringFormat=' ({0})'}" 
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding SavedTargetGroups}" Margin="0,8,0,0"
                                          x:Name="DomainGroupsItemsControl"
                                          AllowDrop="True"
                                          Drop="DomainGroups_Drop"
                                          DragOver="Groups_DragOver">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" 
                                                CornerRadius="4" Margin="0,2" Padding="0,8,0,8"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Drag handle -->
                                                <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" 
                                                        ToolTip="Drag to reorder" Margin="0,0,6,0"
                                                        MouseLeftButtonDown="DomainGroupDragHandle_MouseDown">
                                                    <materialDesign:PackIcon Kind="DotsGrid" Width="16" Height="16" 
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </Border>
                                                <!-- Clickable name/info area -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Normal" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ObjectTypeDisplay}" FontSize="10" 
                                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text=" • " FontSize="10" 
                                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding Paths.Count, StringFormat='{}{0} paths'}" FontSize="10" 
                                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="20" Height="20" ToolTip="Edit group"
                                                        Command="{Binding DataContext.EditGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="20" Height="20" ToolTip="Delete group"
                                                        Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Delete" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Computer Groups -->
                        <Expander IsExpanded="False" Margin="0,0,0,8" 
                                  materialDesign:ExpanderAssist.HorizontalHeaderPadding="0"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="DesktopClassic" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Computer Groups" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding ComputerGroups.Count, StringFormat=' ({0})'}" 
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Empty state -->
                                <TextBlock Text="Computer groups will show here when created"
                                           Visibility="{Binding ComputerGroups.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                                           FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap" Margin="8,0,0,0"/>
                                <!-- Group list -->
                                <ItemsControl ItemsSource="{Binding ComputerGroups}"
                                              x:Name="ComputerGroupsItemsControl"
                                              AllowDrop="True"
                                              Drop="ComputerGroups_Drop"
                                              DragOver="Groups_DragOver">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" 
                                                    CornerRadius="4" Margin="0,2" Padding="0,8,0,8"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.OpenCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit" Command="{Binding DataContext.EditCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Pencil"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Delete" Command="{Binding DataContext.DeleteCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Delete"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Drag handle -->
                                                    <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" 
                                                            ToolTip="Drag to reorder" Margin="0,0,6,0"
                                                            MouseLeftButtonDown="ComputerGroupDragHandle_MouseDown">
                                                        <materialDesign:PackIcon Kind="DotsGrid" Width="16" Height="16" 
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    </Border>
                                                    <!-- Display name -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Normal" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <!-- Edit button -->
                                                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                            Width="20" Height="20" ToolTip="Edit"
                                                            Command="{Binding DataContext.EditCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    </Button>
                                                    <!-- Delete button -->
                                                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                                            Width="20" Height="20" ToolTip="Delete"
                                                            Command="{Binding DataContext.DeleteCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Delete" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- User Groups -->
                        <Expander IsExpanded="False" Margin="0,0,0,8"
                                  materialDesign:ExpanderAssist.HorizontalHeaderPadding="0"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AccountMultiple" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="User Groups" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding UserGroups.Count, StringFormat=' ({0})'}" 
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Empty state -->
                                <TextBlock Text="User groups will show here when created"
                                           Visibility="{Binding UserGroups.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                                           FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap" Margin="8,0,0,0"/>
                                <!-- Group list -->
                                <ItemsControl ItemsSource="{Binding UserGroups}"
                                              x:Name="UserGroupsItemsControl"
                                              AllowDrop="True"
                                              Drop="UserGroups_Drop"
                                              DragOver="Groups_DragOver">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" 
                                                    CornerRadius="4" Margin="0,2" Padding="0,8,0,8"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.OpenCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit" Command="{Binding DataContext.EditCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Pencil"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Delete" Command="{Binding DataContext.DeleteCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Delete"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Drag handle -->
                                                    <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" 
                                                            ToolTip="Drag to reorder" Margin="0,0,6,0"
                                                            MouseLeftButtonDown="UserGroupDragHandle_MouseDown">
                                                        <materialDesign:PackIcon Kind="DotsGrid" Width="16" Height="16" 
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    </Border>
                                                    <!-- Display name -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Normal" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <!-- Edit button -->
                                                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                            Width="20" Height="20" ToolTip="Edit"
                                                            Command="{Binding DataContext.EditCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    </Button>
                                                    <!-- Delete button -->
                                                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                                            Width="20" Height="20" ToolTip="Delete"
                                                            Command="{Binding DataContext.DeleteCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Delete" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Printer Groups -->
                        <Expander IsExpanded="False" Margin="0,0,0,8"
                                  materialDesign:ExpanderAssist.HorizontalHeaderPadding="0"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Printer" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Printer Groups" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding PrinterGroups.Count, StringFormat=' ({0})'}" 
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <!-- Empty state -->
                                <TextBlock Text="Printer groups will show here when created"
                                           Visibility="{Binding PrinterGroups.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                                           FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap" Margin="8,0,0,0"/>
                                <!-- Group list -->
                                <ItemsControl ItemsSource="{Binding PrinterGroups}"
                                              x:Name="PrinterGroupsItemsControl"
                                              AllowDrop="True"
                                              Drop="PrinterGroups_Drop"
                                              DragOver="Groups_DragOver">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" 
                                                    CornerRadius="4" Margin="0,2" Padding="0,8,0,8"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.OpenCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit" Command="{Binding DataContext.EditCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Pencil"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Delete" Command="{Binding DataContext.DeleteCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="Delete"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Drag handle -->
                                                    <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" 
                                                            ToolTip="Drag to reorder" Margin="0,0,6,0"
                                                            MouseLeftButtonDown="PrinterGroupDragHandle_MouseDown">
                                                        <materialDesign:PackIcon Kind="DotsGrid" Width="16" Height="16" 
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                    </Border>
                                                    <!-- Display name -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Normal" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <!-- Edit button -->
                                                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                                            Width="20" Height="20" ToolTip="Edit"
                                                            Command="{Binding DataContext.EditCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    </Button>
                                                    <!-- Delete button -->
                                                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}"
                                                            Width="20" Height="20" ToolTip="Delete"
                                                            Command="{Binding DataContext.DeleteCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Delete" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Navigation section removed - using breadcrumbs and refresh button near search instead
                        <Separator Margin="0,16,0,12"/>
                        <TextBlock Text="NAVIGATION" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding CurrentPath}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Padding="8,4" Margin="0,0,4,0"
                                    Command="{Binding GoBackCommand}"
                                    IsEnabled="{Binding CanGoBack}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center"/>
                                    <TextBlock Text="Back" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Padding="8,4" Margin="0,0,4,0"
                                    Command="{Binding GoToRootCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Home" VerticalAlignment="Center"/>
                                    <TextBlock Text="Root" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Padding="8,4"
                                    Command="{Binding RefreshCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        -->

                    </StackPanel>
                </ScrollViewer>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" 
                              VerticalAlignment="Stretch" Background="Transparent"/>

                <!-- Right Panel - Results & Tools -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Results Area -->
                    <Grid Grid.Row="0" Margin="8">
                        <DockPanel>
                            <!-- Navigation Menu -->
                            <Menu DockPanel.Dock="Top" Margin="0,0,0,12" Background="Transparent">
                                <MenuItem Style="{StaticResource MaterialDesignMenuItem}">
                                    <MenuItem.Template>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid>
                                                <Border x:Name="Border" 
                                                        Background="#1976D2" 
                                                        BorderBrush="#1565C0"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="12,6"
                                                        Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Menu" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                                                        <TextBlock Text="Navigate" VerticalAlignment="Center" Foreground="White" FontWeight="Medium"/>
                                                        <materialDesign:PackIcon Kind="ChevronDown" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                                <Popup x:Name="PART_Popup" 
                                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Placement="Bottom"
                                                       VerticalOffset="4"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Fade">
                                                    <Border Background="{DynamicResource MaterialDesignPaper}"
                                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Margin="8">
                                                        <Border.Effect>
                                                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.3"/>
                                                        </Border.Effect>
                                                        <StackPanel IsItemsHost="True"/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#1565C0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </MenuItem.Template>
                                    
                                    <!-- Domains submenu -->
                                    <MenuItem Header="Domains" ItemsSource="{Binding PresetDomains}"
                                              IsEnabled="{Binding PresetDomains.Count, Converter={StaticResource CountToBoolConverter}}">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                <Setter Property="Header" Value="{Binding Name}"/>
                                                <Setter Property="ToolTip" Value="{Binding DistinguishedName}"/>
                                                <Setter Property="Command" Value="{Binding DataContext.SelectDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <Setter Property="CommandParameter" Value="{Binding}"/>
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                    
                                    <Separator/>
                                    
                                    <!-- Domain Groups submenu -->
                                    <MenuItem Header="Domain Groups">
                                        <MenuItem Header="Multi-Type" ItemsSource="{Binding DomainGroupsMultiType}" IsEnabled="{Binding HasDomainGroupsMultiType}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="Computers" ItemsSource="{Binding DomainGroupsComputers}" IsEnabled="{Binding HasDomainGroupsComputers}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="Users" ItemsSource="{Binding DomainGroupsUsers}" IsEnabled="{Binding HasDomainGroupsUsers}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="Printers" ItemsSource="{Binding DomainGroupsPrinters}" IsEnabled="{Binding HasDomainGroupsPrinters}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                    </MenuItem>
                                    
                                    <Separator/>
                                    
                                    <!-- Custom Groups submenu -->
                                    <MenuItem Header="Saved Groups">
                                        <MenuItem Header="Computers" ItemsSource="{Binding ComputerGroups}" IsEnabled="{Binding HasComputerGroups}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.OpenCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="Users" ItemsSource="{Binding UserGroups}" IsEnabled="{Binding HasUserGroups}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.OpenCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="Printers" ItemsSource="{Binding PrinterGroups}" IsEnabled="{Binding HasPrinterGroups}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.OpenCustomGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                    </MenuItem>
                                </MenuItem>
                            </Menu>

                            <!-- Currently Viewing Status with Cache Info -->
                            <Border DockPanel.Dock="Top" 
                                    Background="{DynamicResource MaterialDesignCardBackground}" 
                                    CornerRadius="4" 
                                    Padding="12,8" 
                                    Margin="0,12,0,8"
                                    Visibility="{Binding SelectedOutputTab.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" 
                                                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="Currently Viewing: " Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <Run Text="{Binding SelectedOutputTab.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Visibility="{Binding SelectedOutputTab.LastUpdated, Converter={StaticResource NullToVisibilityConverter}}">
                                            <Run Text="Last updated at "/>
                                            <Run Text="{Binding SelectedOutputTab.LastUpdatedDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="24" Height="24" Padding="0"
                                                Command="{Binding ForceRefreshCommand}"
                                                ToolTip="Refresh query results (bypass cache)"
                                                VerticalAlignment="Center" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" 
                                                                     Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Back Button and Breadcrumb Path -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                        Visibility="{Binding Breadcrumbs.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <!-- Back Button -->
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Width="28" Height="28"
                                        Padding="0"
                                        ToolTip="Go back one level"
                                        Command="{Binding GoBackCommand}"
                                        IsEnabled="{Binding CanGoBack}">
                                    <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"/>
                                </Button>

                                <!-- Breadcrumb Path -->
                                <ItemsControl ItemsSource="{Binding Breadcrumbs}"
                                              VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding DisplayName}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="8,4"
                                                    MinWidth="0"
                                                    Command="{Binding DataContext.NavigateToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock Text="\" VerticalAlignment="Center" Margin="0"
                                                       Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>

                            <!-- Subfolders List -->
                            <ListBox DockPanel.Dock="Top" 
                                     ItemsSource="{Binding Subfolders}"
                                     SelectedItem="{Binding SelectedFolder}"
                                     Visibility="{Binding Subfolders.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                     MaxHeight="200"
                                     Margin="0,0,0,8"
                                     Style="{StaticResource MaterialDesignListBox}"
                                     SelectionChanged="SubfoldersListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="Folder"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Kind" Value="FolderOpen"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Tabs -->
                            <TabControl x:Name="OutputTabControl"
                                        ItemsSource="{Binding OutputTabs}" 
                                        SelectedItem="{Binding SelectedOutputTab}"
                                        Style="{StaticResource MaterialDesignTabControl}"
                                        SelectionChanged="OutputTabControl_SelectionChanged"
                                        AllowDrop="True">
                                <TabControl.ItemContainerStyle>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="AllowDrop" Value="True"/>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown"/>
                                        <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove"/>
                                        <EventSetter Event="Drop" Handler="TabItem_Drop"/>
                                        <EventSetter Event="DragOver" Handler="TabItem_DragOver"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource MaterialDesignToolBarBackground}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TabControl.ItemContainerStyle>
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Tab type icon -->
                                            <materialDesign:PackIcon Kind="{Binding IconKind}" 
                                                                     Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                     Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            
                                            <!-- Normal header display -->
                                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center"
                                                       Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            
                                            <!-- Close button -->
                                            <Button Style="{StaticResource TabCloseButton}"
                                                    Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.CloseOutputTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Close tab">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Computer/User Results with Filter Panel -->
                                        <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Results|Computers|Users|Printers}">
                                            <Grid.Resources>
                                                <!-- BindingProxy to allow DataGridColumns to access DataContext properties -->
                                                <converters:BindingProxy x:Key="TabProxy" Data="{Binding}"/>
                                            </Grid.Resources>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Filter Status Bar -->
                                            <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}" 
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                    BorderThickness="0,0,0,1" Padding="8,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Filter" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding DataContext.SelectedCount, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontWeight="Medium"/>
                                                        <TextBlock Text=" selected of " VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text="{Binding FilteredCount, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontWeight="Medium"/>
                                                        <TextBlock Text=" objects" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                        <TextBlock Text=" (filtered)" Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                                   Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   VerticalAlignment="Center" FontWeight="Medium" Margin="4,0,0,0"/>
                                                        <!-- Missing members warning for custom groups -->
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasMissingMembers, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Margin="16,0,0,0">
                                                            <TextBlock Text="⚠ " VerticalAlignment="Center" Foreground="OrangeRed"/>
                                                            <TextBlock Text="{Binding MissingMemberCount, Mode=OneWay}" VerticalAlignment="Center" Foreground="OrangeRed"/>
                                                            <TextBlock Text=" missing object(s)" VerticalAlignment="Center" Foreground="OrangeRed"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <!-- Remove missing members button (for custom groups) -->
                                                        <Button Content="Remove Missing" 
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding DataContext.RemoveMissingMembersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Visibility="{Binding HasMissingMembers, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Foreground="OrangeRed"
                                                                ToolTip="Remove objects that no longer exist in Active Directory"
                                                                Padding="8,2" Margin="0,0,8,0"/>
                                                        <!-- Set startup filter button (for groups) -->
                                                        <Button Content="Set Startup Filter" 
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding DataContext.SetStartupFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Visibility="{Binding DataContext.CanSetStartupFilter, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                ToolTip="Save current filters to apply automatically when this group loads"
                                                                Padding="8,2" Margin="0,0,8,0"/>
                                                        <!-- Load startup filter button (for groups with startup filter) -->
                                                        <Button Content="Load Startup Filter" 
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding DataContext.LoadStartupFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Visibility="{Binding DataContext.HasStartupFilter, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                ToolTip="Re-apply the saved startup filter to this tab"
                                                                Padding="8,2" Margin="0,0,8,0"/>
                                                        <!-- Clear startup filter button (for groups with startup filter) -->
                                                        <Button Content="Clear Startup Filter" 
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding DataContext.ClearStartupFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Visibility="{Binding DataContext.HasStartupFilter, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                ToolTip="Remove the saved startup filter for this group"
                                                                Padding="8,2" Margin="0,0,8,0"/>
                                                        <Button Content="Clear Filters" 
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{Binding ClearFiltersCommand}" 
                                                                Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Padding="8,2"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Results DataGrid with Sortable Headers and Inline Filters - Hidden when no results -->
                                            <DataGrid x:Name="ResultsDataGrid" Grid.Row="1" ItemsSource="{Binding AdObjectResults}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserSortColumns="False"
                                                      SelectionMode="Extended"
                                                      SelectionUnit="FullRow"
                                                      Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      Loaded="ResultsDataGrid_Loaded"
                                                      SelectionChanged="ResultsDataGrid_SelectionChanged"
                                                      PreviewMouseLeftButtonDown="ResultsDataGrid_PreviewMouseLeftButtonDown"
                                                      PreviewMouseLeftButtonUp="ResultsDataGrid_PreviewMouseLeftButtonUp"
                                                      PreviewMouseMove="ResultsDataGrid_PreviewMouseMove"
                                                      PreviewKeyDown="ResultsDataGrid_PreviewKeyDown"
                                                      ContextMenuOpening="ResultsDataGrid_ContextMenuOpening">
                                                <DataGrid.ContextMenu>
                                                    <ContextMenu>
                                                        <!-- Selection count header -->
                                                        <MenuItem x:Name="SelectionCountMenuItem" Header="1 item selected" IsEnabled="False" FontWeight="Medium">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="CheckboxMultipleMarked"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem x:Name="ViewPropertiesMenuItem" Header="View All Properties" Click="ViewAllProperties_Click">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="FileDocumentOutline"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <!-- Copy submenu - populated dynamically -->
                                                        <MenuItem x:Name="CopyMenuItem" Header="Copy">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="ContentCopy"/>
                                                            </MenuItem.Icon>
                                                            <!-- Items populated dynamically in ResultsDataGrid_ContextMenuOpening -->
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="{Binding Data.CreateCustomGroupButtonText, Source={StaticResource MainViewModelProxy}}"
                                                                  Command="{Binding Data.CreateCustomGroupFromSelectionCommand, Source={StaticResource MainViewModelProxy}}"
                                                                  IsEnabled="{Binding Data.CanCreateCustomGroup, Source={StaticResource MainViewModelProxy}}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="FolderPlusOutline"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Create group: stale descriptions..."
                                                                  ToolTip="Create a computer group containing selected computers whose Description does not contain their Last User."
                                                                  Command="{Binding Data.CreateStaleDescriptionGroupFromSelectionCommand, Source={StaticResource MainViewModelProxy}}"
                                                                  IsEnabled="{Binding Data.CanCreateStaleDescriptionGroup, Source={StaticResource MainViewModelProxy}}"
                                                                  Visibility="{Binding Data.ShowsComputers, Source={StaticResource TabProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="AccountAlertOutline"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding Data.AddToGroupMenuHeader, Source={StaticResource MainViewModelProxy}}"
                                                                  ItemsSource="{Binding Data.GroupsForSelectionType, Source={StaticResource MainViewModelProxy}}"
                                                                  IsEnabled="{Binding Data.HasGroupsForSelection, Source={StaticResource MainViewModelProxy}}"
                                                                  Visibility="{Binding Data.CanCreateCustomGroup, Source={StaticResource MainViewModelProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="FolderArrowRight"/>
                                                            </MenuItem.Icon>
                                                            <MenuItem.ItemContainerStyle>
                                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                                    <Setter Property="Command" Value="{Binding Data.AddSelectionToGroupCommand, Source={StaticResource MainViewModelProxy}}"/>
                                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                                </Style>
                                                            </MenuItem.ItemContainerStyle>
                                                        </MenuItem>
                                                        
                                                        <!-- Computer/Printer: Network Actions submenu -->
                                                        <Separator Visibility="{Binding Data.ShowsComputers, Source={StaticResource TabProxy}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <MenuItem Header="Network Actions"
                                                                  Visibility="{Binding Data.ShowsComputers, Source={StaticResource TabProxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <MenuItem.Icon>
                                                                <materialDesign:PackIcon Kind="LanConnect"/>
                                                            </MenuItem.Icon>
                                                            <MenuItem Header="Ping" Click="ContextMenuPing_Click">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="AccessPoint"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="Traceroute" Click="ContextMenuTraceroute_Click">
                                                                <MenuItem.Icon>
                                                                    <materialDesign:PackIcon Kind="RoutesClock"/>
