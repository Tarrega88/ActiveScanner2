<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-file publish profile.
  Produces ONE self-contained ActiveScanner.exe that can be shared with coworkers.
  No .NET runtime install is required on the target machine.

  Usage:
    dotnet publish -c Release -p:PublishProfile=SingleFile

  Output:
    publish\single-file\ActiveScanner.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Bundle everything into a single executable -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Keep ReadyToRun off for single-file to minimize size; flip to true for faster startup -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Fixed, predictable output location so the exe is easy to find/share -->
    <PublishDir>publish\single-file\</PublishDir>

    <!-- Don't emit debug symbols (.pdb) so the output is a single file -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
