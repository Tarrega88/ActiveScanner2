<Window x:Class="ActiveScanner.Views.ColumnSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Column Settings" 
        Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select columns to display in results:"
                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ColumnCheckboxes">
                <TextBlock Text="Core Attributes" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkName" Content="Name" IsChecked="True" IsEnabled="False" Margin="0,4"/>
                <CheckBox x:Name="ChkDnsHostName" Content="DNS Hostname" IsChecked="True" Margin="0,4"/>
                <CheckBox x:Name="ChkDescription" Content="Description" IsChecked="True" Margin="0,4"/>
                <CheckBox x:Name="ChkIsEnabled" Content="Enabled Status" IsChecked="True" Margin="0,4"/>
                <CheckBox x:Name="ChkLastLogon" Content="AD Logon" IsChecked="True" Margin="0,4"/>

                <TextBlock Text="Extended Attributes" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <CheckBox x:Name="ChkWhenCreated" Content="Created Date" Margin="0,4"/>
                <CheckBox x:Name="ChkWhenChanged" Content="Modified Date" Margin="0,4"/>
                <CheckBox x:Name="ChkLocation" Content="Location" Margin="0,4"/>
                <CheckBox x:Name="ChkManagedBy" Content="Managed By" Margin="0,4"/>
                <CheckBox x:Name="ChkDistinguishedName" Content="Distinguished Name (Full Path)" Margin="0,4"/>
                
                <TextBlock Text="Multi-Target" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <CheckBox x:Name="ChkSourcePath" Content="Source Path (shows which OU the computer came from)" IsChecked="True" Margin="0,4"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset Defaults" Style="{StaticResource MaterialDesignFlatButton}"
                    Click="ResetDefaults_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}"
                    Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Apply" Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
