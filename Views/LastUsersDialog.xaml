<Window x:Class="ActiveScanner.Views.LastUsersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Last Users" 
        Height="500" Width="650"
        MinHeight="350" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="ComputerNameText" 
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       FontWeight="Medium"/>
            <TextBlock x:Name="UserCountText" 
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            <TextBlock x:Name="LastQueriedText" 
                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tabs Container -->
        <TabControl x:Name="UserTabs" Grid.Row="1">
            <!-- Active User History Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountClock" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Active User History" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                 ToolTip="Users we've caught logged in via 'Query Last User' scans.&#x0a;Shows when they were last seen with an active session."/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="ActiveUsersGrid" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                          Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Username" Width="150" MinWidth="100" SortMemberPath="Username">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Username}" 
                                                   VerticalAlignment="Center" Margin="4,2"
                                                   FontWeight="Medium"/>
                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Padding="0"
                                                Click="CopyUsernameButton_Click"
                                                ToolTip="Copy username"
                                                Tag="{Binding Username}"
                                                Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Last Seen Logged In" Binding="{Binding LastSeenLoggedInFormatted}" Width="140" MinWidth="100" SortMemberPath="LastSeenLoggedIn">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Email" Width="*" MinWidth="150" SortMemberPath="Email">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Email}" 
                                                   VerticalAlignment="Center" Margin="4,2"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   ToolTip="{Binding Email}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Padding="0"
                                                Click="CopyEmailButton_Click"
                                                ToolTip="Copy email"
                                                Tag="{Binding Email}"
                                                Visibility="{Binding Email, Converter={StaticResource NullToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Username" Click="CopyUsername_Click"/>
                            <MenuItem Header="Copy Email" Click="CopyEmail_Click"/>
                            <MenuItem Header="Copy All" Click="CopyAll_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>

            <!-- User Profile History Tab -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountMultiple" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="User Profile History" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                 ToolTip="All user profiles found on the machine via 'User Profiles Scan'.&#x0a;Shows when the profile was last scanned, not when they logged in."/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="ProfileUsersGrid" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                          Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Username" Width="150" MinWidth="100" SortMemberPath="Username">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Username}" 
                                                   VerticalAlignment="Center" Margin="4,2"
                                                   FontWeight="Medium"/>
                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Padding="0"
                                                Click="CopyUsernameButton_Click"
                                                ToolTip="Copy username"
                                                Tag="{Binding Username}"
                                                Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Profile Last Scanned" Binding="{Binding LastProfileScanFormatted}" Width="140" MinWidth="100" SortMemberPath="LastProfileScan">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Email" Width="*" MinWidth="150" SortMemberPath="Email">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Email}" 
                                                   VerticalAlignment="Center" Margin="4,2"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   ToolTip="{Binding Email}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                                Width="20" Height="20" Padding="0"
                                                Click="CopyEmailButton_Click"
                                                ToolTip="Copy email"
                                                Tag="{Binding Email}"
                                                Visibility="{Binding Email, Converter={StaticResource NullToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Username" Click="CopyUsername_Click"/>
                            <MenuItem Header="Copy Email" Click="CopyEmail_Click"/>
                            <MenuItem Header="Copy All" Click="CopyAll_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Refresh Button on Left -->
            <Button x:Name="RefreshButton" 
                    Grid.Column="0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="Refresh_Click"
                    ToolTip="Run a full User Profiles Scan to get all profile data">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center"/>
                    <TextBlock Text="Scan Profiles" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <!-- Loading Indicator -->
            <StackPanel x:Name="LoadingPanel" Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Width="20" Height="20" IsIndeterminate="True"/>
                <TextBlock Text="Scanning..." Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </StackPanel>
            
            <!-- Right-side Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Copy All" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="CopyAll_Click" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
