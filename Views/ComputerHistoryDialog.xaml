<Window x:Class="ActiveScanner.Views.ComputerHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Computer History" 
        Height="400" Width="500"
        MinHeight="250" MinWidth="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="UserNameText" 
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       FontWeight="Medium"/>
            <TextBlock x:Name="ComputerCountText" 
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Computers Grid -->
        <DataGrid x:Name="ComputersGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Computer" Width="*" MinWidth="120" SortMemberPath="ComputerName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ComputerName}" 
                                           VerticalAlignment="Center" Margin="4,2"
                                           FontWeight="Medium"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}"
                                        Width="20" Height="20" Padding="0"
                                        Click="CopyComputerButton_Click"
                                        ToolTip="Copy computer name"
                                        Tag="{Binding ComputerName}"
                                        Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenFormatted}" Width="160" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="4,2"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Computer Name" Click="CopyComputer_Click"/>
                    <MenuItem Header="Copy All" Click="CopyAll_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Right-side Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Copy All" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="CopyAll_Click" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
