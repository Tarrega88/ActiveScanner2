<Window x:Class="ActiveScanner.Views.IncidentTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:ActiveScanner.Models"
        Title="Create ServiceNow Incident Ticket"
        Height="750" Width="950"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with template management -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <materialDesign:PackIcon Kind="TicketConfirmation" Width="28" Height="28" 
                                         VerticalAlignment="Center" Margin="0,0,12,0"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="Create Incident Ticket" Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Margin="0,0,8,0">
                    <ComboBox x:Name="TemplateComboBox" 
                              Width="200" Height="32"
                              IsEditable="True" IsTextSearchEnabled="False"
                              TextSearch.TextPath="Name"
                              materialDesign:HintAssist.Hint="Search templates..."
                              materialDesign:HintAssist.IsFloating="False"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              SelectionChanged="TemplateComboBox_SelectionChanged"
                              PreviewTextInput="TemplateComboBox_PreviewTextInput"
                              PreviewKeyDown="TemplateComboBox_PreviewKeyDown">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource MaterialDesignToolButton}"
                            x:Name="ClearTemplateSearchButton"
                            Width="20" Height="20"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,26,0"
                            ToolTip="Clear search" Click="ClearTemplateSearch_Click"
                            Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                    </Button>
                    <ToggleButton Style="{StaticResource MaterialDesignToolButton}"
                                  Width="20" Height="20"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,4,0"
                                  IsChecked="{Binding IsDropDownOpen, ElementName=TemplateComboBox, Mode=TwoWay}"
                                  Focusable="False">
                        <materialDesign:PackIcon Kind="ArrowDropDown" Width="16" Height="16"/>
                    </ToggleButton>
                </Grid>
                <Button x:Name="SaveTemplateButton" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Save Template" Click="SaveTemplate_Click" Margin="0,0,8,0"
                        Height="32" Padding="12,0"/>
                <Button x:Name="DeleteTemplateButton" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Delete" Click="DeleteTemplate_Click"
                        Height="32" Padding="12,0"
                        Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                        BorderBrush="{DynamicResource MaterialDesignValidationErrorBrush}"
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Main form area with two columns -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0">
                    <!-- Submitted By Section -->
                    <TextBlock Text="SUBMITTED BY" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Submitted by" Style="{StaticResource FieldLabelStyle}"/>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="24" Height="24" ToolTip="How to find sys_id"
                                        Click="SubmittedByHelp_Click">
                                    <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </Button>
                            </Grid>
                            <ComboBox x:Name="SubmittedByComboBox" Style="{StaticResource FieldComboBoxStyle}"
                                      DisplayMemberPath="DisplayText"
                                      materialDesign:HintAssist.Hint="Quick select team member"
                                      SelectionChanged="SubmittedByComboBox_SelectionChanged"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SubmittedByTextBox" Style="{StaticResource FieldTextBoxStyle}"
                                         materialDesign:HintAssist.Hint="sys_id or use dropdown above"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Save as new team member"
                                        Click="SaveSubmittedBy_Click">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="SubmittedByTextBox" Click="InsertVariable_Click">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Affected User Section -->
                    <TextBlock Text="AFFECTED USER" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Affected End-user (Email or SAM)" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AffectedEndUserTextBox" Style="{StaticResource FieldTextBoxStyle}"
                                         LostFocus="AffectedEndUserTextBox_LostFocus"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <materialDesign:PackIcon x:Name="AffectedEndUserCheckIcon" Kind="CheckCircle" 
                                                             Foreground="#4CAF50" Width="20" Height="20" 
                                                             Visibility="Collapsed" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon x:Name="AffectedEndUserErrorIcon" Kind="AlertCircle" 
                                                             Foreground="#F44336" Width="20" Height="20" 
                                                             Visibility="Collapsed" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon x:Name="AffectedEndUserLoadingIcon" Kind="Loading" 
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}" Width="20" Height="20" 
                                                             Visibility="Collapsed" VerticalAlignment="Center">
                                        <materialDesign:PackIcon.RenderTransform>
                                            <RotateTransform x:Name="LoadingRotation" CenterX="10" CenterY="10"/>
                                        </materialDesign:PackIcon.RenderTransform>
                                    </materialDesign:PackIcon>
                                    <TextBlock x:Name="AffectedEndUserStatusText" VerticalAlignment="Center" Margin="4,0,0,0"
                                               FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="AffectedEndUserTextBox" Click="InsertVariable_Click">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Affected User Building Number" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BuildingNumberTextBox" Style="{StaticResource FieldTextBoxStyle}"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="BuildingNumberTextBox" Click="InsertVariable_Click">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Affected User Room Number" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RoomNumberTextBox" Style="{StaticResource FieldTextBoxStyle}"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="RoomNumberTextBox" Click="InsertVariable_Click">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Best Contact Method" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ContactMethodComboBox" Style="{StaticResource FieldComboBoxStyle}"
                                      DisplayMemberPath="DisplayText"/>

                            <TextBlock Text="Affected User Best Follow-up Phone Number" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PhoneNumberTextBox" Style="{StaticResource FieldTextBoxStyle}"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="PhoneNumberTextBox" Click="InsertVariable_Click">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Category Section -->
                    <TextBlock Text="CATEGORIZATION" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CategoryComboBox" Style="{StaticResource FieldComboBoxStyle}"
                                      DisplayMemberPath="DisplayText"
                                      SelectionChanged="CategoryComboBox_SelectionChanged"/>

                            <TextBlock Text="Subcategory" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="SubcategoryComboBox" Style="{StaticResource FieldComboBoxStyle}"
                                      DisplayMemberPath="DisplayText"/>

                            <!-- Affected Service text input (shown only for enterprise_application category) -->
                            <StackPanel x:Name="AffectedServicePanel" Visibility="Collapsed">
                                <TextBlock Text="Affected Service" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AffectedServiceTextBox" Style="{StaticResource FieldTextBoxStyle}"/>
                                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                            Width="32" Height="32" ToolTip="Insert column variable"
                                            Tag="AffectedServiceTextBox" Click="InsertVariable_Click">
                                        <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Description Section -->
                    <TextBlock Text="DESCRIPTION" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Short Description" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ShortDescriptionTextBox" Style="{StaticResource FieldTextBoxStyle}"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="ShortDescriptionTextBox" Click="InsertVariable_Click">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DescriptionTextBox" Style="{StaticResource FieldTextBoxStyle}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" 
                                         VerticalScrollBarVisibility="Auto"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="DescriptionTextBox" Click="InsertVariable_Click"
                                        VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Affected System Name / EE Number / Hostname" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AffectedSystemNameTextBox" Style="{StaticResource FieldTextBoxStyle}"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="AffectedSystemNameTextBox" Click="InsertVariable_Click">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Work Notes" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WorkNotesTextBox" Style="{StaticResource FieldTextBoxStyle}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" 
                                         VerticalScrollBarVisibility="Auto"/>
                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="32" Height="32" ToolTip="Insert column variable"
                                        Tag="WorkNotesTextBox" Click="InsertVariable_Click"
                                        VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="2">
                    <!-- Contact & Priority Section -->
                    <TextBlock Text="CONTACT &amp; PRIORITY" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Contact Type" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ContactTypeComboBox" Style="{StaticResource FieldComboBoxStyle}"
                                      DisplayMemberPath="DisplayText"/>

                            <TextBlock Text="Impact" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ImpactComboBox" Style="{StaticResource FieldComboBoxStyle}"
                                      DisplayMemberPath="DisplayText"/>

                            <TextBlock Text="Urgency" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="UrgencyComboBox" Style="{StaticResource FieldComboBoxStyle}"
                                      DisplayMemberPath="DisplayText"/>
                        </StackPanel>
                    </Border>

                    <!-- Browser Selection -->
                    <TextBlock Text="SETTINGS" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Open tickets in" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="BrowserComboBox" Style="{StaticResource FieldComboBoxStyle}">
                                <ComboBoxItem Content="Microsoft Edge" Tag="Edge"/>
                                <ComboBoxItem Content="Google Chrome" Tag="Chrome"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Affected Items Section -->
                    <TextBlock Text="AFFECTED ITEMS" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <Expander IsExpanded="True">
                            <Expander.Header>
                                <TextBlock x:Name="AffectedItemsHeader" Text="0 items selected" FontWeight="Medium"/>
                            </Expander.Header>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <ItemsControl x:Name="AffectedItemsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                    BorderThickness="0,0,0,1" Padding="4,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding Name}" 
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource MaterialDesignIconButton}"
                                                            Width="24" Height="24"
                                                            Padding="0"
                                                            ToolTip="Remove from ticket"
                                                            Tag="{Binding}"
                                                            Click="RemoveAffectedItem_Click">
                                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" 
                                                                                 Foreground="#F44336"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </Border>

                    <!-- Available Variables Reference -->
                    <TextBlock Text="AVAILABLE VARIABLES" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Click to view column variables" FontWeight="Medium" FontSize="11"/>
                            </Expander.Header>
                            <WrapPanel Margin="0,8,0,0">
                                <ItemsControl x:Name="VariablesList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource MaterialDesignDivider}" 
                                                    CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- URL Preview -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" 
                CornerRadius="4" Padding="12" Margin="0,8,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="URL Preview" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UrlLengthWarning" Grid.Column="1" 
                               Foreground="#FF9800" FontSize="11" Margin="16,0,0,0"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                            Content="Copy URL" Click="CopyPreviewUrl_Click" Padding="8,4"/>
                </Grid>
                <TextBox x:Name="UrlPreviewTextBox" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         MaxHeight="60"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,8,0,0"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="Transparent"
                         BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Copy All URLs" Click="CopyAllUrls_Click" Margin="0,0,8,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="CreateTicketsButton" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="CreateTickets_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="OpenInNew" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CreateTicketsButtonText" Text="Create Tickets" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
