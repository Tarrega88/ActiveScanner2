<Window x:Class="ActiveScanner.Views.RemoteCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Terminal"
        Height="760" Width="920"
        MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,8,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <materialDesign:PackIcon Kind="Console" Width="28" Height="28"
                                     VerticalAlignment="Center" Margin="0,0,12,0"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <StackPanel>
                <TextBlock Text="Terminal" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                <TextBlock Text="Run one command on the selected machines over WinRM and see each result."
                           FontSize="11" Opacity="0.7"/>
            </StackPanel>
        </StackPanel>

        <!-- Command + options -->
        <materialDesign:Card Grid.Row="1" Padding="12" Margin="0,0,0,12" UniformCornerRadius="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="220">
                        <TextBlock Text="Shell" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ShellCombo"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  FontSize="12" Padding="8,4">
                            <ComboBoxItem Content="PowerShell" Tag="PowerShell" IsSelected="True"/>
                            <ComboBoxItem Content="Command Prompt (cmd)" Tag="Cmd"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Width="160" Margin="12,0,0,0">
                        <TextBlock Text="Timeout / machine (min)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TimeoutBox" Text="2"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="12" Padding="8,4"/>
                    </StackPanel>
                    <StackPanel Width="130" Margin="12,0,0,0">
                        <TextBlock Text="Concurrency" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ConcurrencyCombo"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  FontSize="12" Padding="8,4">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="10" IsSelected="True"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="20"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Command" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="CommandBox" MinLines="3" MaxLines="8"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13" Padding="8,6"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Machines grid + output details -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="MachinesGrid" Grid.Row="0"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      SelectionChanged="MachinesGrid_SelectionChanged"
                      materialDesign:DataGridAssist.CellPadding="8,4"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}"
                                        Width="*"/>
                    <DataGridTemplateColumn Header="Status" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                             Fill="{Binding StatusColor, Converter={StaticResource StringToColorBrushConverter}}"/>
                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1" x:Name="DetailsHeader" Text="Output"
                       FontWeight="SemiBold" FontSize="12" Margin="0,10,0,4"/>

            <Border Grid.Row="2" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    Background="{DynamicResource MaterialDesignChipBackground}">
                <TextBox x:Name="OutputBox" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Padding="8"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="Select a machine to see its output."/>
            </Border>
        </Grid>

        <!-- Footer status -->
        <Grid Grid.Row="3" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressText" Grid.Column="0" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="12" Text=""/>
            <TextBlock x:Name="FailuresText" Grid.Column="1" VerticalAlignment="Center"
                       Margin="16,0,0,0" FontSize="11" Foreground="#E53935"
                       TextTrimming="CharacterEllipsis" Text=""/>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                    IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,8,0" Padding="16,4"/>
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,8,0" Padding="16,4"/>
            <Button x:Name="RunButton" Content="Run" Click="RunButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="24,4"/>
        </StackPanel>
    </Grid>
</Window>
