<Window x:Class="ActiveScanner.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Settings" 
        Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid>
        <!-- Main Content -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Application Settings"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Margin="0,0,0,16"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Appearance Section -->
                    <TextBlock Text="APPEARANCE" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkDarkMode" Content="Dark Mode" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Network Settings Section -->
                    <TextBlock Text="NETWORK SETTINGS" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Default timeout (seconds):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtTimeout" Width="60" 
                                         materialDesign:HintAssist.Hint="5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cache Settings Section -->
                    <TextBlock Text="CACHE SETTINGS" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                        CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Query results are cached to improve performance. Set how long to keep cached results before re-querying."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cache duration (minutes):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtCacheTtl" Width="60" 
                                     materialDesign:HintAssist.Hint="720"/>
                        </StackPanel>
                        <TextBlock Text="Set to 0 to disable caching" FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Search Groups Section -->
                <TextBlock Text="SEARCH GROUPS" FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                        CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Import or export your search groups to share with teammates or backup your configuration."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="BtnExportGroups" Content="Export Groups" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="ExportGroups_Click"
                                    HorizontalAlignment="Left" Margin="0,0,8,0"/>
                            <Button x:Name="BtnImportGroups" Content="Import Groups" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="ImportGroups_Click"
                                    HorizontalAlignment="Left" Margin="0,0,8,0"/>
                            <Button x:Name="BtnRestoreDefaults" Content="Restore Defaults" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="RestoreDefaults_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Data Management Section -->
                <TextBlock Text="DATA MANAGEMENT" FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                        CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <Button x:Name="BtnOpenSettingsFolder" Content="Open Settings Folder" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OpenSettingsFolder_Click"
                                HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        
                        <Separator Margin="0,8"/>
                        
                        <!-- Database Import/Export -->
                        <TextBlock Text="Import or export the Last User database to share cached user lookups with teammates or backup your data."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,8,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Button x:Name="BtnExportDatabase" Content="Export Database" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="ExportDatabase_Click"
                                    HorizontalAlignment="Left" Margin="0,0,8,0"/>
                            <Button x:Name="BtnImportDatabase" Content="Import Database" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="ImportDatabase_Click"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <Separator Margin="0,8"/>
                        
                        <TextBlock Text="Clear cached computer history for users. This removes the 'Last Seen' data shown in the Computer History column. History will rebuild when you run Get Last User scans."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,8,0,8"/>
                        <Button x:Name="BtnClearMachineHistory" Content="Clear Machine History" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="ClearMachineHistory_Click"
                                HorizontalAlignment="Left"/>
                        
                        <Separator Margin="0,8"/>
                        
                        <TextBlock Text="Clear cached Last User data for computers. This removes who was last logged in on each machine. Data will rebuild when you run Get Last User scans."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,8,0,8"/>
                        <Button x:Name="BtnClearLastUserCache" Content="Clear Last User Cache" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="ClearLastUserCache_Click"
                                HorizontalAlignment="Left"/>
                        
                        <Separator Margin="0,8"/>
                        
                        <TextBlock Text="Reset all settings to defaults. This will delete your settings file and restore the application to its initial state."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,8,0,8"/>
                        <Button x:Name="BtnResetAllSettings" Content="Reset All Settings" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                BorderBrush="{DynamicResource MaterialDesignValidationErrorBrush}"
                                Click="ResetAllSettings_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save" Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Width="48" Height="48" IsIndeterminate="True"/>
                <TextBlock x:Name="LoadingText" Text="Importing..." Margin="0,16,0,0"
                           Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
